# --- Ambiente ---
ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# --- Dados ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODELS_DIR=models
EVENTS_FILE=events.csv
ITEM_PROPERTIES_FILE=item_properties.csv
CATEGORY_TREE_FILE=category_tree.csv

# --- Pesos de feedback implícito (relevância diferenciada p/ NDCG) ---
WEIGHT_VIEW=1.0
WEIGHT_ADDTOCART=3.0
WEIGHT_TRANSACTION=5.0

# --- Modelo Two-Tower ---
EMBEDDING_DIM=64
NEGATIVE_SAMPLES_PER_POSITIVE=4
LEARNING_RATE=0.001
BATCH_SIZE=1024
MAX_EPOCHS=50
EARLY_STOPPING_PATIENCE=5

# --- Avaliação ---
TOP_K=10

# --- MLflow ---
# Default: file store local. O pipeline roda em uma maquina limpa sem precisar
# subir servidor nenhum. Para usar um MLflow remoto/compartilhado, troque pela
# URI do servidor (ex.: http://localhost:5000 ou http://mlflow:5000 no Docker).
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=retailrocket-two-tower
MLFLOW_REGISTERED_MODEL_NAME=twinrank-ai-two-tower

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
MODEL_STAGE=Production
MODEL_PATH=models/two_tower/model.joblib

# --- Cache e busca vetorial ---
REDIS_URL=redis://localhost:6379/0
FAISS_INDEX_PATH=models/two_tower/item_index.faiss

# --- DataLoader ---
DATALOADER_WORKERS=4
